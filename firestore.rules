rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    // Users collection
    match /users/{uid} {
      // Public read if user is not deleted (must be authenticated)
      allow read: if isAuthenticated() && resource.data.isDeleted != true;
      
      // Owner can write their own profile
      allow write: if isOwner(uid);
      
      // Ticks sub-collection
      match /ticks/{tickId} {
        // Read only if parent user profile is public
        allow read: if getUserData(uid).privacySettings.isPublic == true;
        
        // Owner can write their own ticks
        allow write: if isOwner(uid);
      }
    }
    
    // Trips collection
    match /trips/{tripId} {
      // Read only if trip is public (denormalized field)
      allow read: if resource.data.isPublic == true;
      
      // Create/update: must be authenticated and userId matches auth uid
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      
      // Owner can delete their own trips
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Profiles collection
    match /profiles/{userId} {
      // Any authenticated user can read profiles
      allow read: if isAuthenticated();
      
      // Users can only write their own profile  
      allow write: if isOwner(userId);
    }
    
    // Connections collection
    match /connections/{connId} {
      // Create: requester must be authenticated user
      allow create: if isAuthenticated() && 
                      request.resource.data.requesterId == request.auth.uid &&
                      request.resource.data.status == 'pending';
      
      // Update: receiver can accept/reject (update status)
      allow update: if isAuthenticated() && 
                      resource.data.receiverId == request.auth.uid;
      
      // Read: both parties can read the connection
      allow read: if isAuthenticated() && 
                    (resource.data.requesterId == request.auth.uid || 
                     resource.data.receiverId == request.auth.uid);
      
      // Delete: either party can delete the connection
      allow delete: if isAuthenticated() && 
                      (resource.data.requesterId == request.auth.uid || 
                       resource.data.receiverId == request.auth.uid);
    }
  }
}
